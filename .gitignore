# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
.uv_cache/

# Environment files
.env

# Datasets (preserve .gitkeep and test/heldout data; ignore 1GB+ train)
data/*
!data/**/.gitkeep
data/part1/train/
data/part2/
!data/part1/
!data/part1/test/
!data/part1/test/**
!data/part1/heldout/
!data/part1/heldout/**
!data/part1/validation/
!data/part1/validation/**
!data/part1/details.md

# Checkpoints and models (preserve .gitkeep)
models/*
!models/**/.gitkeep
*.pt
*.bin
*.safetensors
*.ckpt

# Logs (preserve .gitkeep)
logs/*
!logs/**/.gitkeep
wandb/

# Outputs (preserve .gitkeep)
output/*
!output/**/.gitkeep

# Scratch and diagnosis scripts
scratch_*.py
diagnose_cipher.py
*.zip

# Third-party reference code
abhinav_src/
